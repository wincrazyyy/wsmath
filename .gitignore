# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# build output (astro.config.mjs outDir, published by Cloudflare Pages) — never commit
/out/

# the owner's source sales PDFs — input material, used once. The durable
# artifacts are public/courses/*.webp and the JSON that describes them; nothing
# in the build, the schema or the page reads a PDF. At
# 27.6 MB they are dead weight on a repo whose entire deploy trigger is a push.
# Re-generate the pages with `scripts/extract-outline-pages.ts`.
/courses/

# local working notes
/docs/other/
/CLAUDE.local.md

# astro (dist/ is from older local builds; the output is out/)
/dist/
/.astro/

# design/tools/compare.mjs output
/compare/

# the design handoff archive (unpacked into design/)
/wsmath-redesign-handoff.zip
