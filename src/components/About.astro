---
/*
 * How I teach (#about, template L55–107). Three steps, four facts and the teaching photo; about-canvas draws
 * the glyph field, the step solid beside Winson and the small step icons in #about-solid-1..3.
 * The active step carries .is-active (default: the first). ui/about-steps.ts moves it.
 */
import { Picture } from 'astro:assets';
import teachingImg from '../assets/winson-teaching.webp';

const steps = [
  { title: 'Diagnose', zh: '對症下藥', text: 'Find where the marks are lost. Plan week by week.' },
  { title: 'Write to the markscheme', zh: '步步攞分', text: 'Every solution set out the way examiners award marks.' },
  { title: 'Practise', zh: '熟能生巧', text: 'Targeted past papers, corrected after every lesson.' },
];

const facts = [
  { dt: 'Live on Zoom', dd: 'or face to face in Causeway Bay' },
  { dt: 'Cantonese, Mandarin or English', dd: 'Exam answers always in English' },
  { dt: 'Ages 15 to 18', dd: 'IBDP, A-Level / IAL and IGCSE' },
  { dt: 'First Class Honours, CityUHK', dd: 'HKALE Pure Maths, top 4.8%' },
];

const activeStep = 0;

/* Below 1070px the photo spans the page (up to its 820px max); above it sits beside the copy at about 55% of the page. */
const PHOTO_WIDTHS = [400, 640, 820, 1130];
const PHOTO_SIZES = '(max-width: 860px) 100vw, (max-width: 1070px) 820px, (max-width: 1440px) 55vw, 788px';
---

<section id="about" class="about">
  <canvas id="about-canvas" class="canvas" aria-hidden="true"></canvas>
  <div class="body">
    <div id="about-copy" class="copy">
      <div class="title">
        <h2 class="h2">How I teach</h2>
        <p lang="zh-HK" class="zh-sub">攞分必勝法</p>
      </div>
      <ol id="about-steps" class="steps">
        {steps.map((s, i) => (
          <li class:list={['step', { 'is-active': i === activeStep }]} tabindex="0">
            <span id={`about-solid-${i + 1}`} class="solid" aria-hidden="true"></span>
            <div class="step-body">
              <div class="step-head">
                <h3 class="step-title">{s.title}</h3>
                <span lang="zh-HK" class="step-zh">{s.zh}</span>
              </div>
              <p class="step-text">{s.text}</p>
            </div>
          </li>
        ))}
      </ol>
      <dl class="facts">
        {facts.map((f) => (
          <div><dt>{f.dt}</dt><dd>{f.dd}</dd></div>
        ))}
      </dl>
    </div>
    <div class="about-pic">
      <Picture
        src={teachingImg}
        id="about-photo"
        class="photo"
        alt="Winson Siu teaching a live lesson at his laptop, phone and stylus in hand"
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        widths={PHOTO_WIDTHS}
        sizes={PHOTO_SIZES}
        loading="lazy"
        pictureAttributes={{ class: 'contents' }}
      />
    </div>
  </div>
</section>

<script>
  import { initAboutSteps } from '../scripts/ui/about-steps';
  import { initAboutCanvas } from '../scripts/canvases/about';

  const root = document.getElementById('about');
  if (root) initAboutCanvas(root, initAboutSteps(root));
</script>

<style>
  .about {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: #07050A;
    padding-top: clamp(88px, 10cqi, 140px);
    border-bottom: 1px solid rgba(205, 169, 104, 0.28);
  }

  .canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: block;
    z-index: 0;
    pointer-events: none;
  }

  .body {
    position: relative;
    max-width: 1440px;
    margin: 0 auto;
    padding-left: clamp(20px, 4cqi, 48px);
    box-sizing: border-box;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 40px 24px;
  }

  .copy {
    position: relative;
    z-index: 2;
    flex: 1 1 440px;
    max-width: 580px;
    padding: 0 clamp(20px, 4cqi, 0px) clamp(72px, 9cqi, 120px) 0;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .title {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .step {
    display: flex;
    gap: 22px;
    align-items: center;
    padding: 10px 0;
  }
  .solid {
    flex: 0 0 72px;
    height: 72px;
  }
  .step-body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }
  .step-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 16px;
  }
  .step-title {
    margin: 0;
    font-family: 'Noto Serif Display', Didot, Georgia, serif;
    font-stretch: 87.5%;
    font-weight: 400;
    font-size: 28px;
    line-height: 1.15;
    color: #8E8579;
    transition: color 0.45s ease;
  }
  .step-zh {
    font-family: 'Noto Serif TC', 'Songti TC', serif;
    font-weight: 500;
    font-size: 17px;
    letter-spacing: 0.12em;
    color: var(--gold);
    opacity: 0.45;
    transition: opacity 0.45s ease;
  }
  .step-text {
    margin: 0;
    font-size: 17px;
    line-height: 1.55;
    color: #8E8579;
    transition: color 0.45s ease;
  }
  /* The active step (the reference's t1–t3, z1–z3 and d1–d3). */
  .step.is-active .step-title { color: #F3ECE1; }
  .step.is-active .step-zh { opacity: 1; }
  .step.is-active .step-text { color: #B9AFA3; }
  /* Steps are focusable (PLAN.md §7.3; the reference's are not): the page's gold focus ring. */
  .step:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 4px;
    border-radius: 3px;
  }

  .facts {
    margin: 0;
    padding-top: 30px;
    border-top: 1px solid rgba(240, 233, 222, 0.1);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr));
    gap: 22px 32px;
  }
  .facts dt {
    font-size: 16px;
    font-weight: 600;
    color: #F0E9DE;
  }
  .facts dd {
    margin: 4px 0 0;
    font-size: 15px;
    line-height: 1.5;
    color: #9A9085;
  }

  .about-pic {
    position: relative;
    z-index: 1;
    flex: 1 1 560px;
    min-width: 0;
    align-self: center;
    display: flex;
    justify-content: flex-end;
    padding-bottom: clamp(24px, 4cqi, 64px);
  }

  .photo {
    display: block;
    width: 100%;
    max-width: 820px;
    height: auto;
    -webkit-mask-image: linear-gradient(to bottom, #000 74%, transparent 99%);
    mask-image: linear-gradient(to bottom, #000 74%, transparent 99%);
  }

  @container wsm (max-width: 900px) {
    .about-pic {
      align-self: flex-end;
      padding-bottom: 0;
    }
  }
</style>
