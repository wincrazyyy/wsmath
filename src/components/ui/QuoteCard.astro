---
/*
 * One testimonial card, ported from tmCard() in renderVals() (design/reference/app/home.js).
 * Featured cards sit in the 2×2 grid beside the video; the others ride the two scrolling rows, where each row
 * holds its cards twice and the second copy (`dup`) is hidden from assistive technology.
 *
 * "Read full" opens the student's whole testimonial (ui/QuoteDialog.astro, one per student, rendered by
 * Students.astro), and so does a click anywhere on the card: the button's ::after covers the card, so the card's
 * click is the button's own (no script, and the card holds nothing else to click). The button stays the one control
 * for keyboards and screen readers; its focus ring is drawn around the card. In a loop copy the button is out of the
 * tab order; a pointer can still use it.
 */
import type { Voice } from '../../content/types';
import { quoted, voiceSlug } from '../../lib/voices';
import Avatar from './Avatar.astro';

interface Props {
  voice: Voice;
  featured?: boolean;
  dup?: boolean;
}

const { voice: v, featured = false, dup = false } = Astro.props;

const zh = v.lang !== 'en';
const quote = quoted(v, v.quote);
const slug = voiceSlug(v);
/* Width bucket for the scrolling rows: short quotes get the 320px card, the rest 380px. */
const wide = !featured && !(zh ? v.quote.length < 34 : v.quote.length < 70);
---

<figure
  class:list={['tm-card', { 'tm-dup': dup, 'is-featured': featured, 'is-track': !featured, 'is-wide': wide }]}
  aria-hidden={dup ? 'true' : 'false'}
>
  <blockquote class="tm-quote" lang={v.lang}>{quote}</blockquote>
  {v.full !== v.quote && (
    <button type="button" class="tm-read" commandfor={`tm-full-${slug}`} command="show-modal" tabindex={dup ? -1 : undefined}>
      Read full<span class="sr"> testimonial from {v.name}</span><svg aria-hidden="true" width="12" height="12" viewBox="0 0 14 14" fill="none"><path d="M5 2l5 5-5 5" stroke="currentColor" stroke-width="1.5"></path></svg>
    </button>
  )}
  <figcaption class="tm-cap">
    <Avatar voice={v} />
    <span class="tm-who">
      <span class="tm-name">{v.name} <span class="tm-year">({v.year})</span></span>
      <span class="tm-meta">{v.course}</span>
      <span class="tm-meta tm-dest">{v.dest}</span>
    </span>
    <span class="tm-gain">
      <span class="tm-grade">{v.from}<svg aria-hidden="true" width="0.8em" height="0.36em" viewBox="0 0 38 16" fill="none"><path d="M0 8h35M28.5 1.5L35.5 8L28.5 14.5" stroke="currentColor" stroke-width="1.6"></path></svg><span class="sr"> to </span>{v.to}</span>
      <span class="tm-extra">{v.extra}</span>
    </span>
  </figcaption>
</figure>

<style>
  .tm-card {
    position: relative;
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    gap: 18px;
    box-sizing: border-box;
  }
  .is-featured {
    width: auto;
    height: auto;
    margin: 0;
    padding: clamp(24px, 2.4cqi, 32px);
    border: 1px solid rgba(205, 169, 104, 0.24);
    background: #100A17;
  }
  /* Scrolling-row cards are at least 252px tall and grow to fit their quote; a row's cards share the tallest one's
     height (the track stretches them), so no quote is ever cut short. */
  .is-track {
    width: 320px;
    min-height: 252px;
    margin: 0 16px 0 0;
    padding: 22px 22px 20px;
    border: 1px solid rgba(240, 233, 222, 0.09);
    background: #0E0915;
  }
  .is-track.is-wide { width: 380px; }

  /* Quote: Schibsted for English, Noto Serif TC for zh-Hant / zh-HK, Noto Serif SC for zh-Hans. */
  .tm-quote {
    margin: 0;
    font-family: var(--font-body);
    font-size: 15.5px;
    line-height: 1.6;
    color: #E2D9CC;
  }
  .tm-quote:lang(zh) {
    font-family: var(--font-zh-hant);
    font-size: 16px;
    line-height: 1.85;
  }
  .tm-quote:lang(zh-Hans) { font-family: var(--font-zh-hans); }
  .is-featured .tm-quote { font-size: 18px; }

  /* "Read full": a quiet gold link-button under the quote; its padding gives a 32px tall target. */
  .tm-read {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin: -10px 0 -6px -8px;
    padding: 8px;
    border: 0;
    background: none;
    font: inherit;
    font-size: 13.5px;
    line-height: 16px;
    color: var(--gold-light);
    cursor: pointer;
  }
  /* The whole card is the button's hit area. The card is the containing block (position: relative). */
  .tm-read::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  /* The ring goes round the card, inset: the scrolling rows clip anything outside their cards. */
  .tm-read:focus-visible { outline: none; }
  .tm-card:has(.tm-read:focus-visible) {
    outline: 2px solid var(--gold);
    outline-offset: -2px;
  }
  @media (hover: hover) {
    .tm-card:has(.tm-read) { transition: border-color 0.2s; }
    .tm-card:has(.tm-read):hover { border-color: rgba(205, 169, 104, 0.55); }
    .tm-card:hover .tm-read { color: var(--gold-hover); }
  }

  .tm-cap {
    margin-top: auto;
    display: flex;
    align-items: center;
    gap: 12px;
    padding-top: 16px;
    border-top: 1px solid rgba(240, 233, 222, 0.08);
  }
  .tm-who {
    display: flex;
    flex-direction: column;
    min-width: 0;
    flex: 1 1 auto;
    gap: 1px;
  }
  .tm-name {
    font-size: 15px;
    font-weight: 500;
    line-height: 1.35;
    color: #F3ECE1;
  }
  .tm-year {
    font-weight: 400;
    color: #9A9085;
  }
  .tm-meta {
    font-size: 13px;
    line-height: 1.4;
    color: #9A9085;
  }
  .tm-gain {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
  }
  .tm-grade {
    font-family: var(--font-display);
    font-stretch: 75%;
    font-size: 30px;
    line-height: 1;
    white-space: nowrap;
    color: var(--gold);
  }
  .tm-grade svg {
    margin: 0 0.12em;
    vertical-align: 0.16em;
  }
  .tm-extra {
    font-size: 12px;
    color: #9A9085;
    white-space: nowrap;
  }
  /* The reference sets display:none on the destination and the extra line when they are empty. */
  .tm-dest:empty,
  .tm-extra:empty { display: none; }

  /* Phone: marquee cards 286 wide, at least 300 tall. The grade moves to its own line under the name, so the name,
     course and destination get the card's width. */
  @container wsm (max-width: 620px) {
    .tm-card.is-track {
      width: 286px;
      min-height: 300px;
    }
    .tm-cap {
      flex-wrap: wrap;
      row-gap: 10px;
    }
    .tm-gain {
      flex: 1 0 100%;
      flex-direction: row;
      align-items: baseline;
      gap: 12px;
      padding-left: 56px;
      box-sizing: border-box;
    }
  }

  /* Reduced motion: the rows scroll by hand (Students.astro), so the loop copies go. */
  @media (prefers-reduced-motion: reduce) {
    .tm-dup { display: none; }
  }
</style>
