---
/*
 * The header row and the section menu (template L8–36), rendered by Hero inside <header id="top">.
 * Default state: menu closed. Above 960px the desktop nav shows; at 960px and below the Menu button
 * toggles #site-menu (ui/nav.ts sets aria-expanded on the button and data-open on the panel).
 */
import Wordmark from './ui/Wordmark.astro';
import { GOLD, WHATSAPP } from '../lib/site';

const links = [
  { href: '#about', label: 'About' },
  { href: '#packages', label: 'Packages' },
  { href: '#ia', label: 'Maths IA' },
  { href: '#results', label: 'Results' },
  { href: '#students', label: 'Students' },
  { href: '#faq', label: 'FAQ' },
];
---

<div class="hdr">
  <div class="hdr-row">
    <Wordmark />
    <nav class="nav-desk" aria-label="Sections">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <a class="hdr-cta" href={WHATSAPP} target="_blank" rel="noopener">Message Winson</a>
    <button type="button" class="nav-toggle" aria-label="Menu" aria-expanded="false" aria-controls="site-menu"><svg class="nav-ico-open" aria-hidden="true" width="18" height="12" viewBox="0 0 18 12" fill="none"><path d="M0 1h18M0 6h18M0 11h18" stroke="currentColor" stroke-width="1.4"></path></svg><svg class="nav-ico-close" aria-hidden="true" width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.4"></path></svg><span class="nav-label">Menu</span></button>
    <nav id="site-menu" class="nav-panel" aria-label="Sections" data-open="false">
      {links.map((l) => (
        <a href={l.href}>{l.label}<svg aria-hidden="true" width="16" height="12" viewBox="0 0 16 12" fill="none"><path d="M0 6h14.5M9.5 1l5 5-5 5" stroke={GOLD} stroke-width="1.3"></path></svg></a>
      ))}
    </nav>
  </div>
</div>

<script>
  import { initNav } from '../scripts/ui/nav';

  initNav(document);
</script>

<style>
  .hdr {
    position: relative;
    z-index: 6;
  }

  .hdr-row {
    /* the hero's stage width (Hero.astro), so the logo stays over the name on large screens */
    max-width: var(--hero-max, 1440px);
    margin: 0 auto;
    /* the row is --hdr-h tall around its 44px controls (88px; 68px on short screens, set by Hero.astro) */
    padding: calc((var(--hdr-h, 88px) - 44px) / 2) clamp(20px, 4cqi, 48px);
    box-sizing: border-box;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 40px;
  }

  .nav-desk {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 30px;
    font-size: 15px;
  }
  .nav-desk a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: #D6CDBF;
    text-decoration: none;
  }

  .hdr-cta {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 18px;
    box-sizing: border-box;
    border: 1px solid rgba(205, 169, 104, 0.55);
    border-radius: 3px;
    color: #F0E9DE;
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  .nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-width: 44px;
    height: 44px;
    margin: 0;
    padding: 0 14px;
    box-sizing: border-box;
    border: 1px solid rgba(240, 233, 222, 0.22);
    border-radius: 3px;
    background: transparent;
    font-family: 'Schibsted Grotesk', 'Helvetica Neue', Arial, sans-serif;
    font-size: 15px;
    font-weight: 500;
    color: #F0E9DE;
    cursor: pointer;
  }
  .nav-toggle svg {
    flex: 0 0 auto;
  }
  /* Hamburger while closed, cross while open (the reference's navIconOpen / navIconClose). */
  .nav-ico-open { display: block; }
  .nav-ico-close { display: none; }
  .nav-toggle[aria-expanded="true"] .nav-ico-open { display: none; }
  .nav-toggle[aria-expanded="true"] .nav-ico-close { display: block; }

  .nav-panel {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 20;
    display: none;
    flex-direction: column;
    padding: 4px clamp(20px, 4cqi, 48px) 28px;
    box-sizing: border-box;
    background: #09060E;
    border-top: 1px solid rgba(240, 233, 222, 0.08);
    border-bottom: 1px solid rgba(205, 169, 104, 0.32);
    box-shadow: 0 40px 60px -30px rgba(0, 0, 0, 0.85);
    animation: nav-in 0.25s ease both;
    /* The hero clips at the screen's bottom edge, so on a phone held sideways the list scrolls inside the panel
       instead of running past it. */
    max-height: calc(100svh - var(--hdr-h, 88px));
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .nav-panel a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 60px;
    border-bottom: 1px solid rgba(240, 233, 222, 0.08);
    font-family: 'Noto Serif Display', Didot, 'Bodoni 72', Georgia, serif;
    font-stretch: 87.5%;
    font-weight: 400;
    font-size: 26px;
    line-height: 1.1;
    color: #F3ECE1;
    text-decoration: none;
  }
  .nav-panel a svg {
    flex: 0 0 auto;
  }

  /* styles.css (hover only where a pointer hovers; on touch screens it sticks after a tap) */
  @media (hover: hover) {
    .nav-desk a:hover,
    .nav-panel a:hover {
      color: #F3ECE1;
    }
    .nav-toggle:hover {
      border-color: #CDA968;
    }
  }

  @container wsm (max-width: 960px) {
    .hdr-row { column-gap: 12px; }
    .nav-desk { display: none; }
    .nav-toggle { display: inline-flex; }
    .hdr-cta { margin-left: auto; }
    .nav-panel[data-open="true"] { display: flex; }
  }

  @container wsm (max-width: 620px) {
    .nav-label { display: none; }
    .hdr-cta { padding: 0 14px; }
  }

  /* Keep the row on one line (the hero measures itself against an 88px header): tighter on small phones, and
     below 340px the header button gives way; the hero's own WhatsApp button sits right under it. */
  @container wsm (max-width: 400px) {
    .hdr-row { column-gap: 8px; }
    .hdr-cta {
      padding: 0 12px;
      font-size: 14px;
    }
  }
  @container wsm (max-width: 340px) {
    .hdr-cta { display: none; }
    .nav-toggle { margin-left: auto; }
  }
</style>
