---
/*
 * FAQ (#faq): the title and the 3D question mark (faq-canvas, hidden ≤900) on the left, eight native <details> on
 * the right. The plus icon turns to × through the global `details[open] > summary svg` rule.
 */
import data from '../content/faq.json';
import type { FaqItem } from '../content/types';

const items = data as FaqItem[];
---

<section id="faq" class="faq">
  <div class="faq-grid">
    <div class="faq-head">
      <h2 class="h2">FAQ</h2>
      <p lang="zh-Hant" class="zh-sub">常見問題</p>
      <div class="faq-art" aria-hidden="true">
        <canvas id="faq-canvas" class="faq-canvas" aria-hidden="true"></canvas>
      </div>
    </div>
    <div class="faq-list">
      {
        items.map((item) => (
          <details class="faq-item">
            <summary class="faq-q">{item.q}<svg aria-hidden="true" width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M9 2v14M2 9h14" stroke="#CDA968" stroke-width="1.5"></path></svg></summary>
            <p class="faq-a">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { initFaq } from '../scripts/ui/faq';

  const root = document.getElementById('faq');
  if (root) initFaq(root);
</script>

<style>
  .faq {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(88px, 10cqi, 140px) 0;
    background: #07050A;
    border-top: 1px solid rgba(205, 169, 104, 0.18);
  }
  .faq-grid {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 clamp(20px, 4cqi, 48px);
    box-sizing: border-box;
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: 32px clamp(48px, 6cqi, 96px);
    align-items: start;
  }
  .faq-head {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .faq-art {
    position: relative;
    height: 440px;
    margin-top: 12px;
  }
  .faq-canvas {
    position: absolute;
    top: 0;
    left: -40px;
    width: calc(100% + 80px);
    height: 100%;
    display: block;
    pointer-events: none;
  }
  .faq-list {
    min-width: 0;
    border-bottom: 1px solid rgba(240, 233, 222, 0.12);
  }
  .faq-item { border-top: 1px solid rgba(240, 233, 222, 0.12); }
  .faq-q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 44px;
    padding: 22px 0;
    cursor: pointer;
    list-style: none;
    font-size: 19px;
    font-weight: 500;
    line-height: 1.4;
    text-wrap: balance; /* no single word left on a question's last line */
    color: #F0E9DE;
  }
  .faq-q svg {
    flex: 0 0 auto;
    transition: transform 0.2s;
  }
  .faq-a {
    margin: 0;
    padding: 0 0 26px;
    max-width: 62ch;
    font-size: 17px;
    line-height: 1.7;
    color: #B9AFA3;
  }

  @container wsm (max-width: 900px) {
    .faq-grid { grid-template-columns: minmax(0, 1fr); }
    .faq-art { display: none; }
  }
</style>
